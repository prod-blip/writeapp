# The mock provider needs no API key and is the safe local default.
AI_PROVIDER=mock
AI_DEV_TOKEN=clearwrite-local-development
PORT=8787

# To use OpenAI, set AI_PROVIDER=openai and supply both values below.
# Never put OPENAI_API_KEY in the Android app or commit it to source control.
OPENAI_API_KEY=
OPENAI_MODEL=

# Production Google Play subscription verification.
GOOGLE_PLAY_PACKAGE_NAME=com.atulpandey.clearwrite
GOOGLE_PLAY_PRODUCT_ID=clearwrite_pro
# Prefer injecting the complete service-account JSON as a secret.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Or provide these two values instead:
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=
